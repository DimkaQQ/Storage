# Копия этого файла сохраняется как .env рядом с docker-compose.yml НА СЕРВЕРЕ (в git .env не попадает).
# Если заданы ВСЕ переменные набора (iikoserver: URL+логин+пароль, iikocloud: API-логин+ID организации), доступ к iiko берётся только отсюда:
# в программе он не меняется и в файл настроек не пишется. Неполный набор не включает заморозку (предупреждение в логе сервера).
# Чтобы сменить пользователя — правим этот файл и запускаем ./deploy.sh.
# Пусто — доступ настраивается в программе, как раньше.

# iikoserver (по умолчанию, если задан IIKO_SERVER_URL)
IIKO_SERVER_URL=
IIKO_LOGIN=
IIKO_PASSWORD=

# iikocloud (используется, если задан IIKO_API_LOGIN)
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=

# необязательно: явно указать 'iikoserver' или 'iikocloud'
IIKO_PROVIDER=

# необязательно: id организации, к которой относится заморозка (без него — ко всем)
IIKO_LOCK_ORG=


# ---- Две копии на одном сервере (разработка и клиент) ----
# Строки в .env — только КЛЮЧ=значение: без кавычек и без комментариев в той же строке.
# Для копии КЛИЕНТА (папка ~/Storage-prod) в её .env добавьте (для копии разработки ничего из этого не нужно):
#   APP_NAME=pricecheck-prod          имена контейнеров (pricecheck-prod-api / pricecheck-prod)
#   COMPOSE_PROJECT_NAME=pricecheck-prod   отдельные сеть и хранилище данных
#   WEB_PORT=3001                     порт для Caddy (horeca.mirelli.eu → 3001)
#   CADDY_SITES=horeca.caddy          какие файлы из caddy/ ставит эта копия
#   DEPLOY_REF=<sha коммита>          версия клиента закреплена; чтобы обновить клиента — меняете sha и запускаете ./deploy.sh
